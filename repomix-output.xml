 14: const validate = (data: FormData): FormErrors => {
 15:   const errors: FormErrors = {};
 16:   if (!data.firstName.trim()) errors.firstName = form.errors.required;
 17:   const email = data.email.trim();
 18:   if (!email) errors.email = form.errors.required;
 19:   else if (!EMAIL_PATTERN.test(email)) errors.email = form.errors.emailInvalid;
 20:   if (!data.message.trim()) errors.message = form.errors.required;
 21:   return errors;
 22: };
 23: 
 24: const inputBase =
 25:   "mt-2 w-full rounded-xl border bg-slate-50 px-4 py-3 text-sm text-brand-navy placeholder:text-brand-navy/30 transition-all duration-300 cubic-bezier(0.16, 1, 0.3, 1) focus:bg-white focus:outline-none focus:ring-4 shadow-xs";
 26: 
 27: const inputClass = (hasError: boolean) =>
 28:   `${inputBase} ${hasError
 29:     ? "border-brand-secondary/40 focus:border-brand-secondary focus:ring-brand-secondary/10"
 30:     : "border-brand-navy/10 focus:border-brand-primary focus:ring-brand-primary/10"
 31:   }`;
