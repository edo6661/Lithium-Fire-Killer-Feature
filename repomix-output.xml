39:     const t = setTimeout(() => {
40:       setShowTooltip(true);
41:       const hideTimer = setTimeout(() => setShowTooltip(false), 4000);
42:       return () => clearTimeout(hideTimer);
43:     }, 1000);
44:     return () => clearTimeout(t);
45:   }, [visible]);
