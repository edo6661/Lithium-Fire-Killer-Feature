 43:   const handleChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
 44:     const { name, value } = e.target;
 45:     setFormData((prev) => ({ ...prev, [name as FormField]: value }));
 46:     setErrors((prev) => ({ ...prev, [name as FormField]: undefined }));
 47:     setIsSuccess(false);
 48:   };
 49: 
 50:   const handleSubmit = (e: FormEvent<HTMLFormElement>) => {
 51:     e.preventDefault();
 52:     const validationErrors = validate(formData);
 53:     if (Object.keys(validationErrors).length > 0) {
 54:       setErrors(validationErrors);
 55:       return;
 56:     }
 57:     setErrors({});
 58:     setIsSuccess(true);
