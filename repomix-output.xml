 35:   const [errors, setErrors] = useState<FormErrors>({});
 36:   const [isSuccess, setIsSuccess] = useState(false);
 37:   const successRef = useRef<HTMLDivElement>(null);
 38: 
 39:   useEffect(() => {
 40:     if (isSuccess) successRef.current?.focus();
 41:   }, [isSuccess]);
