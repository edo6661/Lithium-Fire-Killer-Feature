<file path="src/components/layout/Header.tsx">
import { useEffect, useState } from "react";
import { Link, NavLink } from "react-router-dom";
import { Menu, X } from "lucide-react";
import { HEADER_NAV } from "../../content";
import { SITE } from "../../config/site";

const NAV_LINKS = HEADER_NAV;

const navLinkClass = ({ isActive }: { isActive: boolean }) =>
  `rounded-lg px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 lg:px-4 ${isActive
    ? "bg-brand-primary/15 text-brand-primary"
    : "text-brand-navy hover:bg-brand-primary/10 hover:text-brand-primary"
  }`;

const mobileNavLinkClass = ({ isActive }: { isActive: boolean }) =>
  `block rounded-lg px-3 py-3 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 ${isActive
    ? "bg-brand-primary/15 text-brand-primary"
    : "text-brand-navy hover:bg-brand-primary/10 hover:text-brand-primary"
  }`;

export const Header = () => {
  const [mobileOpen, setMobileOpen] = useState(false);

  useEffect(() => {
    if (!mobileOpen) return;

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") setMobileOpen(false);
    };

    document.addEventListener("keydown", handleKeyDown);
    return () => document.removeEventListener("keydown", handleKeyDown);
  }, [mobileOpen]);

  useEffect(() => {
    document.body.style.overflow = mobileOpen ? "hidden" : "";
    return () => {
      document.body.style.overflow = "";
    };
  }, [mobileOpen]);

  return (
    <header className="sticky top-0 z-50 border-b border-brand-navy/10 bg-white/95 backdrop-blur-sm">
      <div className="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
        <Link
          to="/"
          className="flex min-w-0 shrink flex-col leading-tight focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 rounded-sm"
          aria-label={`${SITE.shortName} — Beranda`}
        >
          <span className="text-lg font-bold tracking-tight text-brand-navy sm:text-xl">
            {SITE.shortName}
          </span>
          <span className="truncate text-[10px] font-medium text-brand-dark-blue xs:block sm:text-xs max-w-[140px] sm:max-w-none">
            <span className="hidden min-[400px]:inline">{SITE.name}</span>
            <span className="min-[400px]:hidden">{SITE.tagline}</span>
          </span>
        </Link>

        <nav className="hidden md:block" aria-label="Navigasi utama">
          <ul className="flex items-center gap-1 lg:gap-2">
            {NAV_LINKS.map((link) => (
              <li key={link.href}>
                <NavLink
                  to={link.href}
                  className={navLinkClass}
                  end={link.href === "/"}
                >
                  {link.label}
                </NavLink>
              </li>
            ))}
          </ul>
        </nav>

        <button
          type="button"
          className="inline-flex items-center justify-center rounded-lg p-2 text-brand-navy transition-colors hover:bg-brand-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary md:hidden"
          aria-expanded={mobileOpen}
          aria-controls="mobile-nav"
          aria-label={mobileOpen ? "Tutup menu" : "Buka menu"}
          onClick={() => setMobileOpen((open) => !open)}
        >
          {mobileOpen ? <X className="size-6" /> : <Menu className="size-6" />}
        </button>
      </div>

      {mobileOpen && (
        <nav
          id="mobile-nav"
          className="border-t border-brand-navy/10 bg-white md:hidden"
          aria-label="Navigasi mobile"
        >
          <ul className="flex flex-col px-4 py-3 sm:px-6">
            {NAV_LINKS.map((link) => (
              <li key={link.href}>
                <NavLink
                  to={link.href}
                  className={mobileNavLinkClass}
                  end={link.href === "/"}
                  onClick={() => setMobileOpen(false)}
                >
                  {link.label}
                </NavLink>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>
  );
};
