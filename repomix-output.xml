<file path="src/components/ui/AnimateIn.tsx">
 1: import { motion, type Variants } from "framer-motion";
 2: import type { ReactNode } from "react";
 3: 
 4: type AnimateInProps = {
 5:   children: ReactNode;
 6:   className?: string;
 7:   delay?: number;
 8:   direction?: "up" | "down" | "left" | "right" | "none";
 9:   duration?: number;
10:   once?: boolean;
11: };
12: 
13: const variants: Record<string, Variants> = {
14:   up: {
15:     hidden: { opacity: 0, y: 24 },
16:     visible: { opacity: 1, y: 0 },
17:   },
18:   down: {
19:     hidden: { opacity: 0, y: -24 },
20:     visible: { opacity: 1, y: 0 },
21:   },
22:   left: {
23:     hidden: { opacity: 0, x: 32 },
24:     visible: { opacity: 1, x: 0 },
25:   },
26:   right: {
27:     hidden: { opacity: 0, x: -32 },
28:     visible: { opacity: 1, x: 0 },
29:   },
30:   none: {
31:     hidden: { opacity: 0 },
32:     visible: { opacity: 1 },
33:   },
34: };
35: 
36: export const AnimateIn = ({
37:   children,
38:   className,
39:   delay = 0,
40:   direction = "up",
41:   duration = 0.5,
42:   once = true,
43: }: AnimateInProps) => {
44:   return (
45:     <motion.div
46:       className={className}
47:       initial="hidden"
48:       whileInView="visible"
49:       viewport={{ once, margin: "-60px" }}
50:       transition={{
51:         duration,
52:         delay,
53:         ease: [0.21, 0.47, 0.32, 0.98],
54:       }}
55:       variants={variants[direction]}
56:     >
57:       {children}
58:     </motion.div>
59:   );
60: };
</file>

